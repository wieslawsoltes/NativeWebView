<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>NativeWebView.Platform.Windows</AssemblyName>
    <RootNamespace>NativeWebView.Platform.Windows</RootNamespace>
    <PackageId>NativeWebView.Platform.Windows</PackageId>
    <Description>Windows backend registration, diagnostics, dialog support, and WebView2 integration for NativeWebView.</Description>
    <PackageTags>$(PackageTags);Windows;WebView2</PackageTags>
    <IsPackable>true</IsPackable>
    <DefineConstants>$(DefineConstants);NATIVEWEBVIEW_PLATFORM_WINDOWS</DefineConstants>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackWindowsRuntimeAssets</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../NativeWebView.Core/NativeWebView.Core.csproj" />
    <ProjectReference Include="../NativeWebView.Interop/NativeWebView.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" GeneratePathProperty="true">
      <PrivateAssets>buildTransitive</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="PackWindowsRuntimeAssets">
    <!--
      WebView2 keeps its managed runtime bridge outside NuGet's normal runtime
      asset folders and supplies it through buildTransitive targets. Importing
      those targets in consumers also adds the optional WPF and WinForms
      assemblies. Package only the Core bridge as a Windows runtime asset so
      applications receive everything the backend requires without acquiring
      UI-framework references or a direct WebView2 package reference.
    -->
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(PkgMicrosoft_Web_WebView2)/lib_manual/netcoreapp3.0/Microsoft.Web.WebView2.Core.dll"
                              PackagePath="runtimes/win/lib/$(TargetFramework)/" />
      <TfmSpecificPackageFile Include="$(TargetPath)"
                              PackagePath="runtimes/win/lib/$(TargetFramework)/" />
    </ItemGroup>
  </Target>
</Project>
